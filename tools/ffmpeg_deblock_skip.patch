+/*
+ * mib-cluster-map: 1 when deblocking this macroblock cannot change a pixel,
+ * so the per-macroblock set-up (fill_filter_caches, ff_h264_filter_mb) can
+ * be skipped: an inter 16x16 macroblock without luma coefficients (so no
+ * inner edges) whose left and top neighbours are in the same slice, inter,
+ * without luma coefficients beside the shared edge, use the same reference
+ * and motion vectors less than 4 quarter pixels apart. Then bS is 0 on both
+ * edges it filters, as check_mv() would find. Frame pictures with one
+ * reference list only, no 8x8 transform. On the cockpit's 720p stream this
+ * is mostly the map moving as a whole.
+ */
+static av_always_inline int no_deblock_edges(const H264Context *h, const H264SliceContext *sl,
+                                             int mb_x, int mb_y, int mb_xy, int mb_type)
+{
+    const int bs = h->b_stride;
+    const int b_xy = 4 * mb_x + 4 * mb_y * bs;
+    const uint8_t *nnz = h->non_zero_count[mb_xy];
+    int16_t (*const mv)[2] = h->cur_pic.motion_val[0];
+    const int8_t *ri = h->cur_pic.ref_index[0];
+    int ref, k;
+
+    if (sl->list_count != 1 || IS_INTRA(mb_type) || !IS_16X16(mb_type) || IS_8x8DCT(mb_type) ||
+        (AV_RN32A(nnz) | AV_RN32A(nnz + 4) | AV_RN32A(nnz + 8) | AV_RN32A(nnz + 12)))
+        return 0;
+    ref = ri[4 * mb_xy];
+    if (mb_x > 0) {
+        const int l = mb_xy - 1, lt = h->cur_pic.mb_type[l];
+        const uint8_t *ln = h->non_zero_count[l];
+        if (h->slice_table[l] != h->slice_table[mb_xy] || IS_INTRA(lt) || IS_8x8DCT(lt) ||
+            (ln[3] | ln[7] | ln[11] | ln[15]))
+            return 0;
+        for (k = 0; k < 4; k++) {
+            const int16_t *m = mv[b_xy - 1 + k * bs];
+            if (ri[4 * l + (k >> 1) * 2 + 1] != ref ||
+                FFABS(m[0] - mv[b_xy][0]) >= 4 || FFABS(m[1] - mv[b_xy][1]) >= 4)
+                return 0;
+        }
+    }
+    if (mb_y > 0) {
+        const int t = mb_xy - h->mb_stride, tt = h->cur_pic.mb_type[t];
+        if (h->slice_table[t] != h->slice_table[mb_xy] || IS_INTRA(tt) || IS_8x8DCT(tt) ||
+            AV_RN32A(h->non_zero_count[t] + 12))
+            return 0;
+        for (k = 0; k < 4; k++) {
+            const int16_t *m = mv[b_xy - bs + k];
+            if (ri[4 * t + 2 + (k >> 1)] != ref ||
+                FFABS(m[0] - mv[b_xy][0]) >= 4 || FFABS(m[1] - mv[b_xy][1]) >= 4)
+                return 0;
+        }
+    }
+    return 1;
+}
