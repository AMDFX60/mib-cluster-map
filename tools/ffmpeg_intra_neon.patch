+@ The bS = 4 (intra) loop filters, which FFmpeg has in NEON only for
+@ aarch64; on 32-bit ARM they ran in C, about 9 % of the decoding work on
+@ the Superb's recorded cockpit stream (mib-cluster-map 1.4.2). Every load
+@ and store uses byte elements, which need no alignment: the head unit's
+@ QNX kernel stops a NEON access of 16 or 32-bit elements that is not
+@ aligned to its size (see the routines above).
+
+.macro  h264_loop_filter_intra_start
+        cmp             r2,  #0
+        it              ne
+        cmpne           r3,  #0
+        it              eq
+        bxeq            lr
+        vdup.8          d30, r2         @ alpha
+        lsr             r2,  r2,  #2
+        vdup.8          d31, r3         @ beta
+        add             r2,  r2,  #2
+        vdup.8          d29, r2         @ (alpha >> 2) + 2
+.endm
+
+@ Eight lines across a luma edge: d16-d23 = p3 p2 p1 p0 q0 q1 q2 q3, one
+@ byte per line. Changes p2 to q2 (d17-d22) as FFmpeg's C code does, or
+@ branches to \skip when no line is filtered. Uses q0-q3, d24-d28, r2, r3.
+.macro  h264_loop_filter_luma_intra_8 skip
+        vabd.u8         d24, d19, d20   @ abs(p0 - q0)
+        vabd.u8         d25, d18, d19   @ abs(p1 - p0)
+        vabd.u8         d26, d21, d20   @ abs(q1 - q0)
+        vclt.u8         d27, d24, d30   @ < alpha
+        vclt.u8         d25, d25, d31   @ < beta
+        vclt.u8         d26, d26, d31   @ < beta
+        vand            d26, d26, d25
+        vand            d26, d26, d27   @ lines that are filtered
+        vmov            r2,  r3,  d26
+        orrs            r2,  r2,  r3
+        beq             \skip
+        vabd.u8         d27, d17, d19   @ abs(p2 - p0)
+        vabd.u8         d28, d22, d20   @ abs(q2 - q0)
+        vclt.u8         d24, d24, d29   @ < (alpha >> 2) + 2
+        vclt.u8         d27, d27, d31   @ < beta
+        vclt.u8         d28, d28, d31   @ < beta
+        vand            d24, d24, d26
+        vand            d27, d27, d24   @ strong filter, p side
+        vand            d28, d28, d24   @ strong filter, q side
+
+        vaddl.u8        q0,  d19, d20   @ p0 + q0
+        vaddw.u8        q1,  q0,  d18   @ p1 + p0 + q0
+        vaddw.u8        q2,  q1,  d17   @ p2 + p1 + p0 + q0
+        vaddl.u8        q3,  d16, d17   @ p3 + p2
+        vadd.i16        q1,  q1,  q2
+        vshl.i16        q3,  q3,  #1
+        vaddw.u8        q1,  q1,  d21   @ p2 + 2p1 + 2p0 + 2q0 + q1
+        vadd.i16        q3,  q3,  q2    @ 2p3 + 3p2 + p1 + p0 + q0
+        vrshrn.i16      d24, q2,  #2    @ p1'
+        vrshrn.i16      d25, q1,  #3    @ p0'
+        vrshrn.i16      d4,  q3,  #3    @ p2'
+
+        vaddw.u8        q1,  q0,  d21   @ p0 + q0 + q1
+        vaddw.u8        q3,  q1,  d22   @ p0 + q0 + q1 + q2
+        vaddl.u8        q0,  d23, d22   @ q3 + q2
+        vadd.i16        q1,  q1,  q3
+        vshl.i16        q0,  q0,  #1
+        vaddw.u8        q1,  q1,  d18   @ p1 + 2p0 + 2q0 + 2q1 + q2
+        vadd.i16        q0,  q0,  q3    @ 2q3 + 3q2 + q1 + q0 + p0
+        vrshrn.i16      d5,  q3,  #2    @ q1'
+        vrshrn.i16      d6,  q1,  #3    @ q0'
+        vrshrn.i16      d7,  q0,  #3    @ q2'
+
+        vaddl.u8        q0,  d18, d21   @ p1 + q1
+        vaddw.u8        q1,  q0,  d18
+        vaddw.u8        q0,  q0,  d21
+        vaddw.u8        q1,  q1,  d19   @ 2p1 + p0 + q1
+        vaddw.u8        q0,  q0,  d20   @ 2q1 + q0 + p1
+        vrshrn.i16      d2,  q1,  #2    @ p0' (weak)
+        vrshrn.i16      d3,  q0,  #2    @ q0' (weak)
+
+        vbit            d19, d2,  d26
+        vbit            d20, d3,  d26
+        vbit            d17, d4,  d27
+        vbit            d18, d24, d27
+        vbit            d19, d25, d27
+        vbit            d20, d6,  d28
+        vbit            d21, d5,  d28
+        vbit            d22, d7,  d28
+.endm
+
+@ Eight columns of a horizontal edge, from r0 = pix - 4 * stride.
+.macro  h264_v_loop_filter_luma_intra_8
+        mov             r12, r0
+        vld1.8          {d16}, [r12], r1
+        vld1.8          {d17}, [r12], r1
+        vld1.8          {d18}, [r12], r1
+        vld1.8          {d19}, [r12], r1
+        vld1.8          {d20}, [r12], r1
+        vld1.8          {d21}, [r12], r1
+        vld1.8          {d22}, [r12], r1
+        vld1.8          {d23}, [r12]
+        h264_loop_filter_luma_intra_8 1f
+        add             r12, r0,  r1
+        vst1.8          {d17}, [r12], r1
+        vst1.8          {d18}, [r12], r1
+        vst1.8          {d19}, [r12], r1
+        vst1.8          {d20}, [r12], r1
+        vst1.8          {d21}, [r12], r1
+        vst1.8          {d22}, [r12]
+1:
+.endm
+
+function ff_h264_v_loop_filter_luma_intra_neon, export=1
+        h264_loop_filter_intra_start
+        sub             r0,  r0,  r1, lsl #2
+        h264_v_loop_filter_luma_intra_8
+        add             r0,  r0,  #8
+        h264_v_loop_filter_luma_intra_8
+        bx              lr
+endfunc
+
+@ Eight rows of a vertical edge, from r0 = pix - 4: each row's p3 to q3
+@ are loaded as eight bytes and transposed into one register per column,
+@ and stored back the same way (p3 and q3 unchanged).
+.macro  h264_h_loop_filter_luma_intra_8
+        mov             r12, r0
+        vld1.8          {d16}, [r12], r1
+        vld1.8          {d17}, [r12], r1
+        vld1.8          {d18}, [r12], r1
+        vld1.8          {d19}, [r12], r1
+        vld1.8          {d20}, [r12], r1
+        vld1.8          {d21}, [r12], r1
+        vld1.8          {d22}, [r12], r1
+        vld1.8          {d23}, [r12]
+        transpose_8x8   d16, d17, d18, d19, d20, d21, d22, d23
+        h264_loop_filter_luma_intra_8 1f
+        transpose_8x8   d16, d17, d18, d19, d20, d21, d22, d23
+        mov             r12, r0
+        vst1.8          {d16}, [r12], r1
+        vst1.8          {d17}, [r12], r1
+        vst1.8          {d18}, [r12], r1
+        vst1.8          {d19}, [r12], r1
+        vst1.8          {d20}, [r12], r1
+        vst1.8          {d21}, [r12], r1
+        vst1.8          {d22}, [r12], r1
+        vst1.8          {d23}, [r12]
+1:
+.endm
+
+function ff_h264_h_loop_filter_luma_intra_neon, export=1
+        h264_loop_filter_intra_start
+        sub             r0,  r0,  #4
+        h264_h_loop_filter_luma_intra_8
+        add             r0,  r0,  r1, lsl #3
+        h264_h_loop_filter_luma_intra_8
+        bx              lr
+endfunc
+
+@ Eight lines across a chroma edge: d4-d7 = p1 p0 q0 q1. Changes p0 and
+@ q0 (d5, d6). Uses q8, q9, d26-d28.
+.macro  h264_loop_filter_chroma_intra
+        vabd.u8         d26, d5,  d6    @ abs(p0 - q0)
+        vabd.u8         d27, d4,  d5    @ abs(p1 - p0)
+        vabd.u8         d28, d7,  d6    @ abs(q1 - q0)
+        vclt.u8         d26, d26, d30   @ < alpha
+        vclt.u8         d27, d27, d31   @ < beta
+        vclt.u8         d28, d28, d31   @ < beta
+        vaddl.u8        q8,  d4,  d7    @ p1 + q1
+        vand            d26, d26, d27
+        vaddw.u8        q9,  q8,  d4
+        vaddw.u8        q8,  q8,  d7
+        vand            d26, d26, d28   @ lines that are filtered
+        vaddw.u8        q9,  q9,  d5    @ 2p1 + p0 + q1
+        vaddw.u8        q8,  q8,  d6    @ 2q1 + q0 + p1
+        vrshrn.i16      d18, q9,  #2
+        vrshrn.i16      d16, q8,  #2
+        vbit            d5,  d18, d26   @ p0'
+        vbit            d6,  d16, d26   @ q0'
+.endm
+
+function ff_h264_v_loop_filter_chroma_intra_neon, export=1
+        h264_loop_filter_intra_start
+        sub             r0,  r0,  r1, lsl #1
+        vld1.8          {d4},  [r0], r1
+        vld1.8          {d5},  [r0], r1
+        vld1.8          {d6},  [r0], r1
+        vld1.8          {d7},  [r0]
+        h264_loop_filter_chroma_intra
+        sub             r0,  r0,  r1, lsl #1
+        vst1.8          {d5},  [r0], r1
+        vst1.8          {d6},  [r0]
+        bx              lr
+endfunc
+
+@ Row i's p1 p0 q0 q1 into lane i of d4-d7 with a byte-element vld4, and
+@ the changed p0 q0 back with a byte-element vst2 at pix - 1, as the
+@ normal chroma filter above does.
+function ff_h264_h_loop_filter_chroma_intra_neon, export=1
+        h264_loop_filter_intra_start
+        sub             r0,  r0,  #2
+        vld4.8          {d4[0], d5[0], d6[0], d7[0]}, [r0], r1
+        vld4.8          {d4[1], d5[1], d6[1], d7[1]}, [r0], r1
+        vld4.8          {d4[2], d5[2], d6[2], d7[2]}, [r0], r1
+        vld4.8          {d4[3], d5[3], d6[3], d7[3]}, [r0], r1
+        vld4.8          {d4[4], d5[4], d6[4], d7[4]}, [r0], r1
+        vld4.8          {d4[5], d5[5], d6[5], d7[5]}, [r0], r1
+        vld4.8          {d4[6], d5[6], d6[6], d7[6]}, [r0], r1
+        vld4.8          {d4[7], d5[7], d6[7], d7[7]}, [r0], r1
+        h264_loop_filter_chroma_intra
+        sub             r0,  r0,  r1, lsl #3
+        add             r0,  r0,  #1
+        vst2.8          {d5[0], d6[0]}, [r0], r1
+        vst2.8          {d5[1], d6[1]}, [r0], r1
+        vst2.8          {d5[2], d6[2]}, [r0], r1
+        vst2.8          {d5[3], d6[3]}, [r0], r1
+        vst2.8          {d5[4], d6[4]}, [r0], r1
+        vst2.8          {d5[5], d6[5]}, [r0], r1
+        vst2.8          {d5[6], d6[6]}, [r0], r1
+        vst2.8          {d5[7], d6[7]}, [r0], r1
+        bx              lr
+endfunc
+
 @ Biweighted prediction
 
 .macro  biweight_16     macs, macd
