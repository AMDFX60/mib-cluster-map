+/* mib-cluster-map: decode_slice_mbs(), and the deblocking thread's end of
+ * the slice (also after an error). */
+static int decode_slice(struct AVCodecContext *avctx, void *arg)
+{
+    H264SliceContext *sl = arg;
+    int ret = decode_slice_mbs(avctx, arg);
+
+    mibcm_dbt_end(sl->h264, sl);
+    return ret;
+}
