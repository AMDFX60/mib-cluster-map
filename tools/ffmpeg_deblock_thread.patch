+/*
+ * mib-cluster-map 1.4.2: deblocking on its own thread.
+ *
+ * On the head unit (a quad-core Cortex-A9) one decoder thread did all the
+ * work of a 720p picture, and the deblocking filter was 43 % of it. When a
+ * picture is one slice (the phone sends nothing else), decode_slice() now
+ * hands each finished row of macroblocks to a second thread, which filters
+ * it with loop_filter() as the decoder would have, two rows behind: rows
+ * are filtered in the same order and with the same data, so the pictures
+ * stay bit for bit the same. Two rows, because filtering row y changes the
+ * bottom of row y - 1 and all of row y, while decoding row y + 2 reads the
+ * unfiltered bottom of row y + 1 for intra prediction; the decoder runs with
+ * deblocking_filter = 0 for that, as FFmpeg's own postponed filtering does
+ * (no top border exchange). At the end of the slice the decoder waits for
+ * the row in progress and filters what is left itself, so a thread that
+ * gets little CPU costs at most one row of waiting (and its priority is
+ * raised to the decoder's while it is waited for).
+ *
+ * The player switches it on (mibcm_h264_deblock_thread) and may give the
+ * thread a lower priority than the decoder's (mibcm_h264_deblock_priority,
+ * 0 = the decoder's), so it only uses what the unit has to spare.
+ */
+int mibcm_h264_deblock_thread   = 0;
+int mibcm_h264_deblock_priority = 0;
+/* For the player's log: 1 running, -1 could not be started; running totals. */
+volatile int      mibcm_h264_dbt_state       = 0;
+volatile unsigned mibcm_h264_dbt_slices      = 0;
+volatile unsigned mibcm_h264_dbt_rows_thread  = 0;
+volatile unsigned mibcm_h264_dbt_rows_decoder = 0;
+volatile unsigned mibcm_h264_dbt_waits       = 0;
+volatile unsigned mibcm_h264_dbt_wait_us     = 0;
+
+#if HAVE_PTHREADS
+typedef struct MibcmDeblockThread {
+    pthread_t        thread;
+    pthread_mutex_t  lock;
+    pthread_cond_t   work;          /* to the thread: rows ready, or stop */
+    pthread_cond_t   done;          /* to the decoder: a row finished */
+    const H264Context *h;
+    int stop, active, ending, busy;
+    int first_y, first_x;           /* where the slice starts */
+    int next_y;                     /* the next row to filter */
+    int dec_end;                    /* rows above this one are decoded */
+    int part_y, part_x0, part_x1;   /* a last row the slice ends inside */
+    int orig_deblock;
+    H264SliceContext sl;            /* the slice's parameters, for loop_filter() */
+} MibcmDeblockThread;
+
+static void mibcm_dbt_row(MibcmDeblockThread *t, int y, int x0, int x1)
+{
+    t->sl.mb_y = y;
+    loop_filter(t->h, &t->sl, x0, x1);
+}
+
+static void mibcm_dbt_set_priority(MibcmDeblockThread *t, int boost)
+{
+    struct sched_param p, me;
+    int policy, my_policy;
+
+    if (mibcm_h264_deblock_priority <= 0 ||
+        pthread_getschedparam(t->thread, &policy, &p))
+        return;
+    if (boost) {
+        if (pthread_getschedparam(pthread_self(), &my_policy, &me) ||
+            me.sched_priority <= mibcm_h264_deblock_priority)
+            return;
+        p.sched_priority = me.sched_priority;
+    } else {
+        p.sched_priority = mibcm_h264_deblock_priority;
+    }
+    pthread_setschedparam(t->thread, policy, &p);
+}
+
+static void *mibcm_dbt_main(void *arg)
+{
+    MibcmDeblockThread *t = arg;
+
+    if (mibcm_h264_deblock_priority > 0) {
+        struct sched_param p;
+        int policy;
+        if (!pthread_getschedparam(pthread_self(), &policy, &p)) {
+            p.sched_priority = mibcm_h264_deblock_priority;
+            pthread_setschedparam(pthread_self(), policy, &p);
+        }
+    }
+    pthread_mutex_lock(&t->lock);
+    for (;;) {
+        int y;
+        while (!t->stop && !(t->active && !t->ending && t->next_y + 1 < t->dec_end))
+            pthread_cond_wait(&t->work, &t->lock);
+        if (t->stop)
+            break;
+        y = t->next_y++;
+        t->busy = 1;
+        pthread_mutex_unlock(&t->lock);
+
+        mibcm_dbt_row(t, y, y == t->first_y ? t->first_x : 0, t->h->mb_width);
+
+        pthread_mutex_lock(&t->lock);
+        t->busy = 0;
+        mibcm_h264_dbt_rows_thread++;
+        if (t->ending)
+            pthread_cond_signal(&t->done);
+    }
+    pthread_mutex_unlock(&t->lock);
+    return NULL;
+}
+
+/* Decoder, at the start of a slice: 1 if the thread filters its rows. */
+static int mibcm_dbt_begin(const H264Context *hc, H264SliceContext *sl)
+{
+    H264Context *h = (H264Context *)hc;
+    MibcmDeblockThread *t = h->mibcm_dbt;
+
+    if (!mibcm_h264_deblock_thread || !sl->deblocking_filter ||
+        h->postpone_filter || h->nb_slice_ctx_queued != 1 || sl != h->slice_ctx ||
+        h->picture_structure != PICT_FRAME || FRAME_MBAFF(h) || h->pixel_shift ||
+        h->ps.sps->chroma_format_idc != 1 || h->avctx->draw_horiz_band ||
+        (h->avctx->active_thread_type & FF_THREAD_FRAME))
+        return 0;
+
+    if (!t) {
+        if (mibcm_h264_dbt_state < 0)
+            return 0;
+        t = av_mallocz(sizeof(*t));
+        if (!t || pthread_mutex_init(&t->lock, NULL)) {
+            av_free(t);
+            mibcm_h264_dbt_state = -1;
+            return 0;
+        }
+        if (pthread_cond_init(&t->work, NULL)) {
+            pthread_mutex_destroy(&t->lock);
+            av_free(t);
+            mibcm_h264_dbt_state = -1;
+            return 0;
+        }
+        if (pthread_cond_init(&t->done, NULL)) {
+            pthread_cond_destroy(&t->work);
+            pthread_mutex_destroy(&t->lock);
+            av_free(t);
+            mibcm_h264_dbt_state = -1;
+            return 0;
+        }
+        t->h = h;
+        if (pthread_create(&t->thread, NULL, mibcm_dbt_main, t)) {
+            pthread_cond_destroy(&t->done);
+            pthread_cond_destroy(&t->work);
+            pthread_mutex_destroy(&t->lock);
+            av_free(t);
+            mibcm_h264_dbt_state = -1;
+            av_log(h->avctx, AV_LOG_WARNING, "deblocking thread not started\n");
+            return 0;
+        }
+        h->mibcm_dbt = t;
+        mibcm_h264_dbt_state = 1;
+    }
+
+    pthread_mutex_lock(&t->lock);
+    t->sl           = *sl;   /* same top_borders, which the decoder leaves alone now */
+    t->first_y      = sl->mb_y;
+    t->first_x      = sl->mb_x;
+    t->next_y       = sl->mb_y;
+    t->dec_end      = sl->mb_y;
+    t->part_x0      = t->part_x1 = 0;
+    t->orig_deblock = sl->deblocking_filter;
+    t->ending       = 0;
+    t->active       = 1;
+    pthread_mutex_unlock(&t->lock);
+    mibcm_h264_dbt_slices++;
+    return 1;
+}
+
+/* Decoder, at the end of a row: rows above end_y are decoded. */
+static void mibcm_dbt_rows(const H264Context *h, int end_y)
+{
+    MibcmDeblockThread *t = h->mibcm_dbt;
+
+    if (!t || !t->active)
+        return;
+    pthread_mutex_lock(&t->lock);
+    t->dec_end = end_y;
+    pthread_cond_signal(&t->work);
+    pthread_mutex_unlock(&t->lock);
+}
+
+/* Decoder, where the slice ends inside a row: what loop_filter() got. */
+static void mibcm_dbt_partial(const H264Context *h, const H264SliceContext *sl,
+                              int x0, int x1)
+{
+    MibcmDeblockThread *t = h->mibcm_dbt;
+
+    if (!t || !t->active)
+        return;
+    t->part_y  = sl->mb_y;
+    t->part_x0 = x0;
+    t->part_x1 = x1;
+}
+
+/* Decoder, after the slice (also after an error): every row it finished is
+ * filtered when this returns, and the thread is idle. */
+static void mibcm_dbt_end(const H264Context *h, H264SliceContext *sl)
+{
+    MibcmDeblockThread *t = h->mibcm_dbt;
+    int y;
+
+    if (!t || !t->active)
+        return;
+    pthread_mutex_lock(&t->lock);
+    t->ending = 1;
+    if (t->busy) {
+        int64_t t0 = av_gettime_relative();
+        mibcm_dbt_set_priority(t, 1);
+        while (t->busy)
+            pthread_cond_wait(&t->done, &t->lock);
+        mibcm_dbt_set_priority(t, 0);
+        mibcm_h264_dbt_waits++;
+        mibcm_h264_dbt_wait_us += (unsigned)(av_gettime_relative() - t0);
+    }
+    y = t->next_y;
+    pthread_mutex_unlock(&t->lock);
+
+    for (; y < t->dec_end; y++) {
+        mibcm_dbt_row(t, y, y == t->first_y ? t->first_x : 0, h->mb_width);
+        mibcm_h264_dbt_rows_decoder++;
+    }
+    if (t->part_x1 > t->part_x0)
+        mibcm_dbt_row(t, t->part_y, t->part_x0, t->part_x1);
+
+    pthread_mutex_lock(&t->lock);
+    t->active = 0;
+    t->ending = 0;
+    pthread_mutex_unlock(&t->lock);
+    sl->deblocking_filter = t->orig_deblock;
+}
+
+void ff_h264_mibcm_dbt_free(H264Context *h)
+{
+    MibcmDeblockThread *t = h->mibcm_dbt;
+
+    if (!t)
+        return;
+    pthread_mutex_lock(&t->lock);
+    t->stop = 1;
+    pthread_cond_signal(&t->work);
+    pthread_mutex_unlock(&t->lock);
+    pthread_join(t->thread, NULL);
+    pthread_cond_destroy(&t->done);
+    pthread_cond_destroy(&t->work);
+    pthread_mutex_destroy(&t->lock);
+    av_freep(&h->mibcm_dbt);
+}
+#else
+static int  mibcm_dbt_begin(const H264Context *h, H264SliceContext *sl) { return 0; }
+static void mibcm_dbt_rows(const H264Context *h, int end_y) { }
+static void mibcm_dbt_partial(const H264Context *h, const H264SliceContext *sl,
+                              int x0, int x1) { }
+static void mibcm_dbt_end(const H264Context *h, H264SliceContext *sl) { }
+void ff_h264_mibcm_dbt_free(H264Context *h) { }
+#endif
