###########################################################################################
#
# Custom Green Engineering Menu screen: phone map on the digital cluster
# Attached to the top level of the green engineering menu, so it does not
# depend on any other screen being installed.
# Main -> ClusterMap
#
# The entries run scripts straight from the SD card in slot 1:
#   /fs/sda0/ClusterMap/GEM/
#
###########################################################################################
screen ClusterMap Main

keyValue
    value   String sys 0x00000000 0
    label   "Phone map on the digital cluster"
    poll    0

keyValue
    value   String sys 0x00000000 0
    label   "SD card must be in slot 1. Reboot after install."
    poll    0

script
    value   sys 1 0x0100 "/fs/sda0/ClusterMap/GEM/status.sh"
    label   "1. Status and compatibility check"

script
    value   sys 1 0x0100 "/fs/sda0/ClusterMap/GEM/install.sh"
    label   "2. Install cluster map"

script
    value   sys 1 0x0100 "/fs/sda0/ClusterMap/GEM/uninstall.sh"
    label   "Uninstall and restore original state"

script
    value   sys 1 0x0100 "/fs/sda0/ClusterMap/GEM/card_hidden.sh"
    label   "Turn card hidden (standard), then reboot"

script
    value   sys 1 0x0100 "/fs/sda0/ClusterMap/GEM/card_top_right.sh"
    label   "Turn card top right, then reboot"

script
    value   sys 1 0x0100 "/fs/sda0/ClusterMap/GEM/card_top_left.sh"
    label   "Turn card top left, then reboot"

script
    value   sys 1 0x0100 "/fs/sda0/ClusterMap/GEM/size_smaller.sh"
    label   "Test: map smaller (DPI -10), then reboot"

script
    value   sys 1 0x0100 "/fs/sda0/ClusterMap/GEM/size_larger.sh"
    label   "Test: map larger (DPI +10), then reboot"

script
    value   sys 1 0x0100 "/fs/sda0/ClusterMap/GEM/size_reset.sh"
    label   "Map size as installed, then reboot"

script
    value   sys 1 0x0100 "/fs/sda0/ClusterMap/GEM/switch_to_turn_by_turn.sh"
    label   "Switch to turn-by-turn arrows instead (no map)"

keyValue
    value   String sys 0x00000000 0
    label   "Tests 1.4.1: each step, then reboot, drive, Save logs"
    poll    0

script
    value   sys 1 0x0100 "/fs/sda0/ClusterMap/GEM/step1.sh"
    label   "Step 1: software decoder, stream recorded"

script
    value   sys 1 0x0100 "/fs/sda0/ClusterMap/GEM/step2.sh"
    label   "Step 2: hardware decoder"

script
    value   sys 1 0x0100 "/fs/sda0/ClusterMap/GEM/step3.sh"
    label   "Step 3: hardware decoder, rectangle xywh"

script
    value   sys 1 0x0100 "/fs/sda0/ClusterMap/GEM/step4.sh"
    label   "Step 4: hardware decoder, output 0"

script
    value   sys 1 0x0100 "/fs/sda0/ClusterMap/GEM/step5.sh"
    label   "Step 5: software decoder, delay window 3"

script
    value   sys 1 0x0100 "/fs/sda0/ClusterMap/GEM/step6.sh"
    label   "Step 6: back to standard"

script
    value   sys 1 0x0100 "/fs/sda0/ClusterMap/GEM/savelogs.sh"
    label   "Save logs to SD"

script
    value   sys 1 0x0100 "/fs/sda0/ClusterMap/GEM/collect_for_porting.sh"
    label   "Collect files for porting (quick)"

script
    value   sys 1 0x0100 "/fs/sda0/ClusterMap/GEM/collect_for_porting_full.sh"
    label   "Collect for porting, with Java image (55 MB, slow)"
